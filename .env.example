# MetroViz-NC development environment
# Copy this file to .env and adjust the values for your setup.

# Local Nextcloud instance you develop against
NEXTCLOUD_URL=http://localhost:8080
NEXTCLOUD_USER=admin
NEXTCLOUD_PASSWORD=admin

# k6 load-test (see tests/load/metroviz-load.k6.js)
# K6_NC_BASE=https://nc.example.com
# K6_NC_USER=loadtest
# K6_NC_PASS=<app-password>
