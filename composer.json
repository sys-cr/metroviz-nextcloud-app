{
    "name": "metroviz/metroviz-nc",
    "description": "MetroViz Nextcloud app",
    "type": "project",
    "license": "MIT",
    "config": {
        "platform": {
            "php": "8.3"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "OCA\\MetroViz\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\MetroViz\\Tests\\": "tests/php/",
            "OCP\\": "vendor/nextcloud/ocp/OCP/",
            "OC\\": "vendor/nextcloud/ocp/OC/"
        }
    },
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "nextcloud/ocp": "dev-stable32",
        "phpunit/phpunit": "^9.6"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test:php": "phpunit -c phpunit.xml.dist",
        "fix-style": "php-cs-fixer fix",
        "check-style": "php-cs-fixer fix --dry-run --diff"
    }
}
