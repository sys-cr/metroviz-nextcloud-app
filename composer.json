{
    "name": "metroviz/metroviz-nc",
    "description": "MetroViz Nextcloud app",
    "type": "project",
    "license": "MIT",
    "config": {
        "platform": {
            "php": "8.1"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "OCA\\MetroViz\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\MetroViz\\Tests\\": "tests/php/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpunit/phpunit": "^9.6"
    },
    "scripts": {
        "test:php": "phpunit -c phpunit.xml.dist",
        "fix-style": "php-cs-fixer fix",
        "check-style": "php-cs-fixer fix --dry-run --diff"
    }
}
