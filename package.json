{
  "name": "metroviz-nc",
  "version": "0.3.1",
  "description": "MetroViz Nextcloud App",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "lint": "eslint js/nc-storage.js js/nc-autosave.js js/nc-dialogs.js js/files-viewer-handler.js js/stories/ tests/ .storybook/",
    "format": "prettier --write 'js/**/*.{js,mjs}' 'tests/**/*.js' '.storybook/**/*.js' 'css/nc-overrides.css'",
    "format:check": "prettier --check 'js/**/*.{js,mjs}' 'tests/**/*.js' '.storybook/**/*.js' 'css/nc-overrides.css'",
    "audit:check": "npm audit --omit=dev --audit-level=moderate",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "^8.2.0",
    "@storybook/addon-essentials": "^8.2.0",
    "@storybook/html-vite": "^8.2.0",
    "@vitest/coverage-v8": "^1.6.0",
    "axe-core": "^4.11.4",
    "eslint": "^9.0.0",
    "globals": "^17.6.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.3.0",
    "storybook": "^8.2.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "alpinejs": "^3.13.10",
    "d3": "^7.9.0",
    "dompurify": "^3.1.6",
    "i18next": "^23.11.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "jspdf": "^4.2.1",
    "lz-string": "^1.5.0",
    "marked": "^12.0.0",
    "svg2pdf.js": "^2.7.0"
  }
}
